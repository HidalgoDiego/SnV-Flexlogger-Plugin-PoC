<VI _name="OT Order Amplitude.vi" description="Amplitude of one order in a linear order power spectrum (same math as SVFA Power in Band).\0Aamplitude (EU rms) = sqrt( sum of bins from order - half-width to order + half-width / window ENBW ).\0ABins are rounded to the nearest index and clipped to the spectrum. Empty spectrum or a band outside it -&gt; 0.\0Awindow ENBW = 1.5 for Hanning (it undoes the window's spreading of one order over several bins).">
  <Control uid="101" _name="magnitude" type="array{double}" value="[]" outputs="value:101.value" conIdx="11" connection="required" description="Linear power spectrum (EU^2 rms) of one channel." uid_parent="root" />
  <Control uid="102" _name="order 0" type="double" value="0" outputs="value:102.value" conIdx="10" connection="recommended" uid_parent="root" />
